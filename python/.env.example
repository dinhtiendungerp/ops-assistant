# Chep file nay thanh python/.env roi dien gia tri. File .env da nam trong .gitignore.
# KHONG commit .env, khong gui secret qua chat, khong chup man hinh file nay khi da dien.
# Huong dan tung bien: README.md, muc "Chay tren Business Central that" va "Bat AI".

# ---------------------------------------------------------------- Nguon du lieu
# mock = du lieu mo phong trong bc_agent/fixtures (khong can BC). api = goi Business Central that.
BC_MODE=mock
# api = custom API page cua app NWV Marou Agent (mac dinh). odata = web service khai tay, duong du phong.
BC_SOURCE=api

# ---------------------------------------------------------------- Business Central (chi can khi BC_MODE=api)
# Moi truong demo cua NaviWorld: tenant demo CONTOSO, environment NWV01, company NWV.
BC_TENANT_ID=bfea8d1a-c0a1-45fd-ba95-903daff0cb05
BC_CLIENT_ID=70b548dd-6795-4dcc-9a19-7e3809f8f06b
# Secret cua Entra app (ten secret "Marou"). Xin nguoi phu trach du an, khong co trong repo.
BC_CLIENT_SECRET=
BC_ENVIRONMENT=NWV01
# Company mac dinh (cong cu dong lenh dung company nay).
BC_COMPANY_NAME=NWV-MAROU
# Cac company tro ly chay song song, moi company mot tro ly. Marou san xuat, Dakao ban le. Rong thi chi BC_COMPANY_NAME.
BC_COMPANIES=NWV-MAROU,NWV-DAKAO

# ---------------------------------------------------------------- Email nhac viec (skills/nhac_post.py)
# auto: co MAIL_SENDER thi gui qua Microsoft Graph, co SMTP_HOST thi qua SMTP, khong co gi thi chi luu file .eml trong runs/thu-di.
MAIL_MODE=auto
# Nguoi nhan email nhac post chung tu, nhieu dia chi cach nhau dau phay.
MAIL_TO=
# Microsoft Graph: hop thu co that trong tenant. Entra app can quyen Mail.Send (Application) da admin consent.
MAIL_SENDER=
# SMTP (vi du Gmail can App Password): dien tay, khong gui qua chat.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gio chay nen moi sang de nhac post nhan hang. Rong la tat.
NHAC_POST_GIO=08:00
# UC2 A2: gio tro ly tu quet Inventory Health, ghi de xuat cho lo het han, gui brief va nhac; rong = tat
QUET_UC2_GIO=07:30

# ---------------------------------------------------------------- AI (chi can khi LLM_MODE=live)
# scripted = khong goi model (rule, kich ban da duyet, ban ghi). live = goi model that.
LLM_MODE=scripted
LLM_PROVIDER=azure
# Azure OpenAI: Endpoint va Key lay o resource "Marou" (Azure portal > Keys and Endpoint, hoac Foundry).
# DEPLOYMENT la ten deployment, phai trung ten model gpt-4.1-mini de so chi phi tinh dung gia.
AZURE_OPENAI_ENDPOINT=https://marou.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=
# Chi dung khi LLM_PROVIDER=anthropic (duong doi chieu).
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------- Tuy chon
# Tran chi phi AI (USD). Cham tran thi tro ly tu ve rule, khong bao loi.
AGENT_DAILY_BUDGET_USD=2
AGENT_TOTAL_BUDGET_USD=10
# Khoa cho MCP server khi goi tu may khac: khoa:user_id,khoa2:user_id2. Goi tu 127.0.0.1 thi khong can.
MCP_KEYS=
